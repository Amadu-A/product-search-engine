{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "recognized",
        "insufficient_evidence"
      ]
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "product_candidate",
        "category_listing",
        "other",
        "unknown"
      ]
    },
    "product_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "generic_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brand_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "manufacturer_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "mpn_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "evidence_ids"
        ]
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "$ref": "#/$defs/claim"
        },
        "manufacturer": {
          "$ref": "#/$defs/claim"
        },
        "mpn": {
          "$ref": "#/$defs/claim"
        },
        "model": {
          "$ref": "#/$defs/claim"
        },
        "mark": {
          "$ref": "#/$defs/claim"
        },
        "series": {
          "$ref": "#/$defs/claim"
        },
        "seller_code": {
          "$ref": "#/$defs/claim"
        }
      },
      "required": [
        "brand",
        "manufacturer",
        "mpn",
        "model",
        "mark",
        "series",
        "seller_code"
      ]
    }
  },
  "required": [
    "status",
    "record_kind",
    "product_type",
    "generic_type",
    "purpose",
    "applications",
    "brand_candidate",
    "manufacturer_candidate",
    "mpn_candidate",
    "attributes",
    "evidence_ids",
    "reason",
    "identifiers"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-search:answer-1:v2",
  "title": "ProductUnderstandingAnswerV1",
  "$defs": {
    "claim": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "origin": {
              "enum": [
                "source",
                "inferred"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 12
            }
          },
          "required": [
            "value",
            "origin",
            "evidence_ids"
          ]
        }
      ]
    }
  }
}
