{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-search-engine.local/schemas/catalog_items_v1.schema.json",
  "title": "Product Search Engine: catalog_items_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string", "minLength": 1, "maxLength": 128},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"], "maxLength": 10000},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 10000},
        "source_key": {"$ref": "#/$defs/nullableText"},
        "brand": {"$ref": "#/$defs/nullableText"},
        "manufacturer": {"$ref": "#/$defs/nullableText"},
        "mpn": {"$ref": "#/$defs/nullableText"},
        "model": {"$ref": "#/$defs/nullableText"},
        "mark": {"$ref": "#/$defs/nullableText"},
        "series": {"$ref": "#/$defs/nullableText"},
        "seller_sku": {"$ref": "#/$defs/nullableText"},
        "technical_characteristics": {"$ref": "#/$defs/nullableText"},
        "unit": {"$ref": "#/$defs/nullableText"},
        "quantity": {"anyOf": [{"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, {"type": "null"}]},
        "price": {"anyOf": [{"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, {"type": "null"}]},
        "currency": {"anyOf": [{"type": "string", "pattern": "^[A-Z]{3}$"}, {"type": "null"}]},
        "price_date": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
        "seller": {"$ref": "#/$defs/nullableText"},
        "seller_inn": {"$ref": "#/$defs/nullableText"},
        "product_url": {"anyOf": [{"type": "string", "format": "uri", "maxLength": 4096}, {"type": "null"}]},
        "category_path": {"anyOf": [{"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}, "minItems": 1}, {"type": "null"}]}
      }
    }
  }
}
