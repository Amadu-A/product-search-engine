# .env.example
# Безопасный baseline: Pydantic и Compose читают этот файл перед приватным .env.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=product_search
POSTGRES_USER=product_search_app
POSTGRES_PASSWORD=
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
SOURCE_BASE_URL=https://petrovich.ru
SOURCE_CATALOG_PATH=/catalog/
HTTP_USER_AGENT=ProductSearchTaxonomy/0.1
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RESPONSE_BYTES=8388608
SNAPSHOT_MAX_BYTES=67108864
HTTP_MIN_INTERVAL_SECONDS=2
HTTP_RETRIES=2
TAXONOMY_MAX_NODES=20000
TAXONOMY_MAX_DEPTH=32
ARTIFACT_DIR=.tmp/taxonomy
# Только для HTTP fetch-petrovich; локальный import этот файл не читает.
PERMISSION_FILE=.tmp/taxonomy/permission.json
REPORT_FILE=.tmp/reports/petrovich_taxonomy_import.md
LOG_LEVEL=INFO
VCS_REF=unknown
APP_UID=1000
APP_GID=1000
POSTGRES_IMAGE=postgres:16.15-alpine
PYTHON_IMAGE=python:3.12-slim
POSTGRES_MEMORY_LIMIT=512m
APP_MEMORY_LIMIT=512m
# Только для тестов: URL отдельной временной БД, не production.
TEST_DATABASE_URL=

# Этап 02: shared-контракты, очередь, UI и лимиты. Реальные секреты только в .env.
INFERENCE_MODE=live
JOB_TRANSPORT=rabbitmq
SHARED_VLM_BASE_URL=http://shared-vlm:8000/v1
SHARED_VLM_MODEL=shared-vlm
SHARED_VLM_MODEL_REVISION=unverified
SHARED_EMBEDDING_BASE_URL=http://shared-embedding:8000/v1
SHARED_EMBEDDING_MODEL=shared-embedding
SHARED_EMBEDDING_MODEL_REVISION=unverified
INFERENCE_TIMEOUT_SECONDS=90.0
READINESS_TIMEOUT_SECONDS=5.0
INFERENCE_RETRIES=1
INFERENCE_CONCURRENCY=2
INFERENCE_MAX_TOKENS=1200
INFERENCE_MAX_INPUT_CHARS=16000
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_ALIAS=product_taxonomy_categories_active
QDRANT_IMAGE=qdrant/qdrant:v1.19.0
QDRANT_TIMEOUT_SECONDS=15.0
EMBEDDING_DIMENSIONS=4096
MOCK_EMBEDDING_DIMENSIONS=64
EMBEDDING_BATCH_SIZE=32
TAXONOMY_RECONCILE_INTERVAL_SECONDS=900
TAXONOMY_INDEX_WORKER_ENABLED=true
CATEGORY_CANDIDATE_TOP_K=10
TAXONOMY_OUTBOX_MAX_ATTEMPTS=5
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=product_search_engine_app
RABBITMQ_VHOST=product-search-engine
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=product-search-engine.ingest.v1
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=300
UPLOAD_DIR=.tmp/uploads
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_ROWS=100000
UPLOAD_MAX_FILES=10
UPLOAD_PREVIEW_ROWS=20
UPLOAD_MAX_FIELD_CHARS=10000
UPLOAD_MAX_SHEETS=20
UPLOAD_MAX_CELLS=2000000
UPLOAD_ZIP_MAX_BYTES=268435456
UPLOAD_ZIP_MAX_RATIO=100
UPLOAD_TTL_SECONDS=86400
HTTP_BIND_IP=127.0.0.1
HTTP_HOST_PORT=0
API_PORT=8000
API_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=2g
QDRANT_MEMORY_LIMIT=1g
LIVE_SMOKE_ENABLED=false
